# Environment configuration template for Shram Setu 2.0
# The app operates out-of-the-box in Local Demo Mode using IndexedDB.
# Cloud integrations are optional and activated when provisioned.

# Gemini API Key (optional: server-side capabilities)
GEMINI_API_KEY=

# Supabase Cloud Backend (optional: PostgreSQL + Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
